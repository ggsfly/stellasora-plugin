{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "星塔旅人攻略查询",
  "description": "星塔旅人（Stella Sora）游戏攻略查询：角色/技能/素材信息、配队/纹章/秘纹/技能优先度指南、游戏术语中英查词。数据来自 stelladb 攻略站与游戏解包中英字典（29,158 条官方译名映射），输出为官方中文。",
  "author": {
    "name": "ggsfly",
    "url": "https://github.com/ggsfly"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/ggsfly/stellasora-plugin",
    "homepage": "https://stelladb.pages.dev/",
    "documentation": "https://github.com/ggsfly/stellasora-plugin#readme",
    "issues": "https://github.com/ggsfly/stellasora-plugin/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.2.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "compass"
    }
  },
  "capabilities": [
    "config.get",
    "send.text",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "ggsfly.stellasora-plugin"
}